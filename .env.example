# OpenAI-compatible Chat Completions configuration.
# All values can also be entered from the API badge in the Workmate header.
# Use the base URL, including /v1 when required; do not add /chat/completions.
WORKMATE_LLM_BASE_URL=
WORKMATE_LLM_API_KEY=
WORKMATE_LLM_MODEL=
# Optional: OpenRouter reasoning effort for models supporting this option.
WORKMATE_LLM_REASONING_EFFORT=
